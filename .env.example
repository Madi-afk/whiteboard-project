KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=whiteboard
KEYCLOAK_CLIENT_ID=whiteboard-frontend
KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth

# Link copied by the app. Use your LAN/VPN/tunnel URL, not localhost.
PUBLIC_APP_URL=http://10.111.152.226:5173
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Real SMTP example for Gmail.
# Gmail requires 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=your-email@gmail.com
KEYCLOAK_SMTP_FROM_NAME=Whiteboard
KEYCLOAK_SMTP_USER=your-email@gmail.com
KEYCLOAK_SMTP_PASSWORD=your-16-character-app-password
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true

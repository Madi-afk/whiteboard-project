MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whiteboards

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_REALM=whiteboard
KEYCLOAK_CLIENT_ID=whiteboard-frontend
KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_GOOGLE_ENABLED=false
KEYCLOAK_GITHUB_ENABLED=false

# OAuth identity providers for Keycloak.
# For local testing, use these callback URLs in Google/GitHub.
# If KEYCLOAK_PUBLIC_URL is not localhost, replace the host here too.
# Google redirect URI:
# http://localhost:8080/realms/whiteboard/broker/google/endpoint
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=
# GitHub callback URL:
# http://localhost:8080/realms/whiteboard/broker/github/endpoint
KEYCLOAK_GITHUB_CLIENT_ID=
KEYCLOAK_GITHUB_CLIENT_SECRET=

# Link copied by the app. Use your LAN/VPN/tunnel URL, not localhost.
# You can update this automatically with:
# powershell -ExecutionPolicy Bypass -File scripts/update-public-url.ps1 -Restart
PUBLIC_APP_URL=http://YOUR-LAN-OR-VPN-IP:5173
# Prefer a stable computer name over a daily-changing IP, for example DESKTOP.
PUBLIC_APP_HOSTNAME=YOUR-COMPUTER-NAME

# For Google/GitHub OAuth outside localhost, use HTTPS tunnel/domain URLs:
# powershell -ExecutionPolicy Bypass -File scripts/configure-public-oauth-urls.ps1 `
#   -AppUrl https://your-app-domain.example `
#   -KeycloakUrl https://your-keycloak-domain.example

# Real SMTP example for Gmail.
# Gmail requires 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=your-email@gmail.com
KEYCLOAK_SMTP_FROM_NAME=Whiteboard
KEYCLOAK_SMTP_USER=your-email@gmail.com
KEYCLOAK_SMTP_PASSWORD=your-16-character-app-password
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true
